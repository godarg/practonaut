{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.godarg/practonaut",
  "title": "Practonaut",
  "description": "Local practice gym for AI agents on real apps: practice Excalidraw tasks, get a reproducible score.",
  "version": "0.3.0-dev.0",
  "repository": {
    "url": "https://github.com/godarg/practonaut",
    "source": "github"
  },
  "websiteUrl": "https://github.com/godarg/practonaut#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "practonaut",
      "version": "0.3.0-dev.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "--task"
        },
        {
          "type": "positional",
          "value": "excalidraw/connect",
          "description": "The library task the session starts on (practonaut tasks list shows all)."
        }
      ]
    }
  ]
}
